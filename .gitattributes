# Enforce LF line endings on all text files
* text=auto eol=lf

# Explicitly declare text files
*.py text eol=lf
*.sql text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.txt text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
*.parquet binary
