[sqlfluff]
dialect = postgres
templater = raw
max_line_length = 120
# Excluir style rules: layout (LT*), capitalização (CP*), aliasing (AL*)
# Manter apenas syntax errors e structural issues
exclude_rules = LT01,LT02,LT03,LT04,LT05,LT06,LT07,LT08,LT09,LT10,LT11,LT12,LT13,CP01,CP02,CP03,CP04,CP05,AL01,AL02,AL03,AL04,AL05

[sqlfluff:indentation]
indent_unit = space

[sqlfluff:layout:type:comma]
line_position = trailing
